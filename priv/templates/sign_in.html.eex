<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in to <%= Plug.HTML.html_escape(app_name) %></title>
    <meta name="description" content="Sign in to <%= Plug.HTML.html_escape(app_name) %> with one of the available accounts." />
    <link rel="stylesheet" href="<%= base %>/amur.css" />
  </head>
  <body>
    <main class="amur-page">
      <section class="amur-card">
        <%= case logo do %>
          <% :none -> %>
          <% {:svg, markup} -> %>
            <span class="amur-logo" aria-hidden="true"><%= markup %></span>
          <% {:path, path} -> %>
            <img class="amur-logo" src="<%= Plug.HTML.html_escape(path) %>" alt="" />
        <% end %>
        <h1 class="amur-title">Sign in to <%= Plug.HTML.html_escape(app_name) %></h1>
        <p class="amur-divider">Choose an account to continue</p>

        <%= if length(providers) <= 2 do %>
          <nav class="amur-providers--list" aria-label="Sign-in providers">
            <%= for provider <- providers do %>
              <a class="amur-provider" href="<%= base %>/<%= provider %>">
                <span class="amur-provider-icon" aria-hidden="true"><%= icon.(provider) %></span>
                <span>Continue with <%= label.(provider) %></span>
              </a>
            <% end %>
          </nav>
        <% else %>
          <nav class="amur-providers--grid" aria-label="Sign-in providers">
            <%= for provider <- providers do %>
              <a class="amur-provider" href="<%= base %>/<%= provider %>">
                <span class="amur-provider-icon" aria-hidden="true"><%= icon.(provider) %></span>
                <span>Continue with <%= label.(provider) %></span>
              </a>
            <% end %>
          </nav>
        <% end %>
      </section>
    </main>
  </body>
</html>
